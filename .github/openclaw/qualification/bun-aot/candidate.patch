+pub(in crate::lower) fn get_held_values(
+    lowering: &mut FunctionLowering<'_, '_, '_, '_, '_>,
+) -> SmallVec<[ValueId; 4]> {
+    let mut values: SmallVec<[ValueId; 4]> = SmallVec::new();
+    for index in 0..lowering.coroutine.held.len() {
+        let binding = lowering.coroutine.held[index];
+        let placement = lowering.file.scopes.placement(binding);
+        let value = match (lowering.scopes.find_local(binding), placement) {
+            (Some(local), _) => lowering.builder.read_variable(local.variable),
+            (None, Some(placement)) => match placement.storage {
+                Storage::Field { scope, .. } => scope::get_environment(lowering, scope),
+                Storage::Local | Storage::Variable(_) => continue,
+            },
+            (None, None) => continue,
+        };
+        if !values.contains(&value) {
+            values.push(value);
+        }
+    }
+    values
+}
