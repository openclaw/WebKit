+// RUN: link
+// CHECK: expectedresult [[expected]] type=[[chain]] layouts={{*}}[[chain]], [[row]]]
+// CHECK: layout [[chain]] name="Chain<Row>"
+// CHECK: layout [[row]] name="Row"
+// CHECK: function {{*}}name="fluent"
+// CHECK: = Call {{*}}expectedResult=[[expected]]
+// CHECK: Return
+
+// Whoever creates the result creates what its fields hold: a `Chain<Row>` and a `Row`. Every method returns another
+// instantiation of `Chain`, which has the same methods again, so what the signatures name has no end.
+interface Row {
+  id: number;
+}
+
+interface Chain<T> {
+  value: T;
+  optional(): Chain<T | undefined>;
+  array(): Chain<T[]>;
+  and<U>(other: Chain<U>): Chain<[T, U]>;
+  map: <U>(change: (value: T) => U) => Chain<U | T>;
+}
+
+declare function chain<T>(): Chain<T>;
+
+export function fluent() {
+  return chain<Row>();
+}
diff --git a/test/aot/ir/lower/expected-results/written-result-without-end.ts b/test/aot/ir/lower/expected-results/written-result-without-end.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91f17c1229d166574ecd1609e2588efa87db5a7e
--- /dev/null
+++ b/test/aot/ir/lower/expected-results/written-result-without-end.ts
@@ -0,0 +1,47 @@
+// RUN: lower
+// CHECK-LABEL: function {{*}}name="endless"
+// CHECK-NOT: expectedResult=
+// CHECK: Return
+
+// RUN(FINITE): lower
+// FINITE-LABEL: function {{*}}name="finite"
+// FINITE: = Call {{*}}expectedResult=
+// FINITE: Return
+
+// RUN(NESTED): lower
+// NESTED-LABEL: function {{*}}name="nested"
+// NESTED: = Call {{*}}expectedResult=
+// NESTED: Return
+
+// STATISTIC: MaxExpectedResultLayoutsHits = 1
+
+// The fields of `Grow<"a">` reach `Grow<"ax">`, whose fields reach `Grow<"axx">`. Each has a name of its own, so each is a layout: more layouts than
+// one expected result lists, so the call is an ordinary call. The next call is not affected. The fields of `Nest<T>` reach `Nest<Nest<T>>`, which has
+// the names of `Nest<T>` and so its layout: that has an end.
+type Grow<K extends string> = {
+  [P in K | "next"]: P extends "next" ? Grow<`${K}x`> | undefined : number;
+};
+
+interface List<T> {
+  value: T;
+  next: List<T> | undefined;
+}
+
+interface Nest<T> {
+  nested: T;
+  next: Nest<Nest<T>> | undefined;
+}
+
+declare function make<T>(): T;
+
+export function endless() {
+  return make<Grow<"a">>();
+}
+
+export function finite() {
+  return make<List<number>>();
+}
+
+export function nested() {
+  return make<Nest<number>>();
+}
