+pub(in crate::lower) fn lower_member_reads(
+    lowering: &mut FunctionLowering<'_, '_, '_, '_, '_>,
+    expression: ExprId,
+) {
+    let hir = lowering.file.hir;
+    let decisions = lowering.file.decisions();
+    if expression.is_none()
+        || decisions.is_dead_expr(expression)
+        || !decisions.reads_member(expression)
+        || !lowering.enter_nesting(hir[expression].pos)
+    {
+        return;
+    }
+    match hir[expression].kind {
+        ExprKind::Unary {
+            op: UnOp::Void,
+            operand,
+        } => super::lower_expression_for_effect(lowering, operand),
+        ExprKind::Binary {
+            op: BinOp::Comma,
+            left,
+            right,
+        } => {
+            super::lower_expression_for_effect(lowering, left);
+            lower_member_reads(lowering, right);
+        }
+        ExprKind::Unary { operand, .. }
+        | ExprKind::As { expr: operand, .. }
+        | ExprKind::Satisfies { expr: operand, .. }
+        | ExprKind::AsConst(operand)
+        | ExprKind::NonNull(operand)
+        | ExprKind::Instantiation { expr: operand, .. } => lower_member_reads(lowering, operand),
+        ExprKind::Binary { left, right, .. } => {
+            lower_member_reads(lowering, left);
+            lower_member_reads(lowering, right);
+        }
+        ExprKind::Template { exprs } => {
+            for substitution in hir.ids(exprs) {
+                lower_member_reads(lowering, substitution);
+            }
+        }
+        ExprKind::Cond { test, branches } => {
+            let branches = hir.branches(branches);
+            lower_member_reads(lowering, test);
+            lower_member_reads(lowering, branches.yes);
+            lower_member_reads(lowering, branches.no);
+        }
+        _ => lower_read_of_locked_path(lowering, expression),
+    }
+    lowering.leave_nesting();
+}
+
+pub(in crate::lower) fn lower_read_of_locked_path(
+    lowering: &mut FunctionLowering<'_, '_, '_, '_, '_>,
+    path: ExprId,
+) {
+    let member = match lowering.file.builtins.of_pure_expr(path) {
+        Some(Resolved::Builtin(member)) => member,
+        Some(Resolved::DynamicGlobal(_) | Resolved::Intrinsic(_)) => return,
+        // The table ends above this name: `process.versions.bun`. The host makes such an object whole, so only the reads on the way to it show.
+        None => {
+            if let ExprKind::Dot { obj, .. } | ExprKind::Index { obj, .. } =
+                lowering.file.hir[path].kind
+            {
+                lower_member_reads(lowering, obj);
+            }
+            return;
+        }
+    };
+    if member.locked_builtin().is_some() {
+        super::emit_locked_builtin(lowering, member.id);
+        return;
+    }
+    // No operation names a locked data property. Its read stays, and the engine takes from it what nobody can see.
+    // The way to its holder may be one that a program can change, as `globalThis.process` is: the build knows the answer all the same, so it knows the holder.
+    let entry = table::entry(member.id);
+    if let Some(holder) = entry.holder
+        && entry.mutability == Mutability::AlwaysLocked
+        && !table::is_legal_builtin_constant(member.id)
+        && table::is_legal_builtin_constant(holder)
+        && !table::is_symbol_name(entry.name)
+    {
+        let object = super::emit_locked_builtin(lowering, holder);
+        let text = lowering.file.intern_bytes(table::text_of_name(entry.name));
+        let key = lowering.file.text_key(text);
+        lowering.builder.prop_get(object, key, false, false);
+    }
+}
