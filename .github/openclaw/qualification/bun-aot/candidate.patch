+fn strict_import_survives_a_soft_typescript_re_export_of_the_same_name() {
+    let files = [
+        (
+            "main.ts",
+            "import { x } from './barrel.js'; export { x as y } from './barrel.js'; console.log(x);",
+        ),
+        (
+            "barrel.js",
+            "export * from './one.cjs'; export * from './two.cjs';",
+        ),
+        ("one.cjs", "exports.x = 1;"),
+        ("two.cjs", "exports.z = 2;"),
+    ];
+    with_program(&files, |program| {
+        let strict = RequiredName::new(program.module("barrel.js"), program.atom("x"));
+        let soft = RequiredName {
+            may_be_absent: true,
+            asked_by: Some(ExportStatement {
+                export_name: program.atom("y"),
+                specifier: program.atom("./barrel.js"),
+            }),
+            ..strict
+        };
+        assert_eq!(
+            program.graph.required_names(program.file("main.ts")),
+            [soft, strict]
+        );
+    });
+}
