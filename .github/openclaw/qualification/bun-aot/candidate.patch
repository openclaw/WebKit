-    if (!known) this.verdicts.set(value, (known = new Map()));
-    let verdict = known.get(type.id);
-    if (verdict === undefined) known.set(type.id, (verdict = this.matchesNow(type, value)));
-    return verdict;
-  }
-  matchesNow(type: Description, value: any): boolean {
