+  [function () {
+(capture); object.capture<number>();
+  }, 38, 19, "prior-parenthesized-expression"],
+  [function () {
+(capture)<<T>() => T>();
+  }, 41, 22, "generic-function-type"],
+  [function () {
+(capture)!();
+  }, 44, 11, "non-null-callee"],
+  [function () {
+(capture)!<number>();
+  }, 47, 19, "generic-non-null-callee"],
+  [function () {
+(capture)!!();
+  }, 50, 12, "repeated-non-null-callee"],
+  [function () {
