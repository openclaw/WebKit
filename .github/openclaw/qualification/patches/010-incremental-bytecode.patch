+    m_payloadBudget->bytes.fetch_add(charge, std::memory_order_relaxed);
+    bytecode.setIncrementalCacheID(id);
+    bytecode.setDestructionCallback([budget = m_payloadBudget.copyRef(), charge] {
+        budget->bytes.fetch_sub(charge, std::memory_order_relaxed);
+    });
